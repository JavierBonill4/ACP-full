# --- server ---------------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:3000
# 32+ random bytes. Signs the session JWTs issued after wallet verification.
JWT_SECRET=change-me-to-32-plus-random-bytes-please

# --- database -------------------------------------------------------------
# SQLite for local dev. Swap the provider in prisma/schema.prisma for Postgres.
DATABASE_URL="file:./dev.db"

# --- solana ---------------------------------------------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com
ACP_PROGRAM_ID=ACPv4Wa11etRep11111111111111111111111111111
# Do NOT hardcode a devnet USDC mint anywhere else — devnet mints rotate.
# Create your own: spl-token create-token --decimals 6
USDC_MINT=
TREASURY_ADDRESS=

# Single platform-controlled oracle key. Every payout depends on this being
# honest and available — see ARCHITECTURE.md §11. base58 secret key.
ORACLE_SECRET_KEY=

# --- agent dispatch -------------------------------------------------------
# Outbound HTTP to operator-controlled URLs. Keep the SSRF guard on outside
# local development.
AGENT_DISPATCH_TIMEOUT_MS=30000
ALLOW_PRIVATE_AGENT_ENDPOINTS=false
