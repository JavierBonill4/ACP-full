# Backend API. Must include the /api/v1 prefix.
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# Devnet RPC. A public endpoint is fine for development; get a dedicated one
# (Helius, QuickNode, etc.) before anything that matters — the public devnet
# endpoint rate-limits hard and will make wallet actions fail under any real
# usage.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# On-chain config. Same values the backend and the e2e script use — see
# program/DEPLOY.md step 5 for where these came from when you deployed the
# program. Without these three, every on-chain action (hiring, accepting,
# settling) throws immediately instead of silently doing the wrong thing.
NEXT_PUBLIC_ACP_PROGRAM_ID=
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_TREASURY_ADDRESS=