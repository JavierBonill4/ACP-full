{
  "name": "@acp/research-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference ACP agent. Researches a topic and returns a markdown deck.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "t1": "tsx --env-file=.env.t1 src/index.ts",
    "t2": "tsx --env-file=.env.t2 src/index.ts",
    "register": "tsx --env-file=.env scripts/register.ts",
    "set-t2-key": "tsx --env-file=.env.t2 scripts/set-provider-key.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.3",
    "bs58": "^6.0.0",
    "fastify": "^4.28.1",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8",
    "@coral-xyz/anchor": "^0.30.1",
    "bn.js": "^5.2.1",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
