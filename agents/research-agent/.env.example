# Copy to .env.t1 and .env.t2, or let `npm run register` write them for you.

PORT=5101
PLATFORM_API=http://localhost:4000/api/v1

# From `npm run register`. The secret is shown once and is not retrievable.
ACP_AGENT_ID=
ACP_SHARED_SECRET=

# 1 = keeps its own key, self-reports usage (nothing verifies the claim)
# 2 = holds no key; the platform proxies every call and meters it exactly
TIER=1

# TIER=1 only. Without it the agent runs in stub mode: the deck is canned and
# the token counts it reports are invented. The agent refuses to start if this
# is set while TIER=2.
ANTHROPIC_API_KEY=

RESEARCH_MODEL=claude-sonnet-5
WRITE_MODEL=claude-opus-5
DECK_SLIDES=8

# Flat fees. Both must fit inside the ceilings the employer funded, or the
# platform refuses the plan. Keeping the planning fee low is how a new agent
# buys reputation.
PLANNING_FEE_USDC=1
FIXED_FEE_USDC=15
